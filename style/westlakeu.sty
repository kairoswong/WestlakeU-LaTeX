%% ===================================================================
%% Part 3 - Font system (hierarchical, auto-detecting)
%% ===================================================================
%%
%% Design:
%%
%%   Fonts are separated into three independent axes:
%%     1. Western (serif / sans / mono)
%%     2. CJK     (main / sans)
%%     3. Math    (OpenType via unicode-math, or default)
%%
%%   Each axis provides several named presets.  The top-level command
%%   \wl@set@font@auto  detects the OS and available fonts, then
%%   chains the appropriate presets.
%%
%%   OS detection   →  Western preset  →  Western fonts loaded
%%                  →  CJK preset      →  CJK fonts loaded
%%                  →  Math preset     →  Math fonts loaded
%%
%%   The detection runs at \AtEndPreamble so user packages and options
%%   loaded in the preamble take effect first.
%% ===================================================================

\RequirePackage{fontspec}
\RequirePackage{xeCJK}

%% ---- 3.1  OS detection ----
\newif\ifwl@os@windows
\newif\ifwl@os@mac
\newif\ifwl@os@linux

\newcommand\wl@detect@os{%
  \IfFileExists{/System/Library/Fonts/Menlo.ttc}{%
    \wl@os@mactrue
    \wl@info{Detected OS: macOS}%
  }{%
    \IfFileExists{C:/Windows/Fonts/arial.ttf}{%
      \wl@os@windowstrue
      \wl@info{Detected OS: Windows}%
    }{%
      \IfFileExists{/usr/share/fonts}{%
        \wl@os@linuxtrue
        \wl@info{Detected OS: Linux}%
      }{%
        \wl@info{OS detection: assuming Linux}%
        \wl@os@linuxtrue
      }%
    }%
  }%
}

%% ---- 3.2  Western font presets ----

% \wl@set@font@serif@times
%   Tries Times New Roman → TeX Gyre Termes → default.
\newcommand\wl@set@font@serif@{%
  \IfFontExistsTF{Times New Roman}{%
    \setmainfont{Times New Roman}%
    \wl@info{Western serif: Times New Roman}%
  }{%
    \IfFontExistsTF{TeX Gyre Termes}{%
      \setmainfont{TeX Gyre Termes}%
      \wl@info{Western serif: TeX Gyre Termes (Times fallback)}%
    }{%
      \wl@warning{No Times-like serif font found, using default}%
    }%
  }%
}

% \wl@set@font@sans@default
%   Tries Arial → TeX Gyre Heros → default.
\newcommand\wl@set@font@sans@{%
  \IfFontExistsTF{Arial}{%
    \setsansfont{Arial}%
    \wl@info{Western sans: Arial}%
  }{%
    \IfFontExistsTF{TeX Gyre Heros}{%
      \setsansfont{TeX Gyre Heros}%
      \wl@info{Western sans: TeX Gyre Heros (Arial/Helvetica fallback)}%
    }{%
      \wl@warning{No Arial-like sans font found, using default}%
    }%
  }%
}

% \wl@set@font@mono@default
%   Tries Courier New → TeX Gyre Cursor → default.
\newcommand\wl@set@font@mono@{%
  \IfFontExistsTF{Courier New}{%
    \setmonofont{Courier New}%
    \wl@info{Western mono: Courier New}%
  }{%
    \IfFontExistsTF{TeX Gyre Cursor}{%
      \setmonofont{TeX Gyre Cursor}%
      \wl@info{Western mono: TeX Gyre Cursor (Courier fallback)}%
    }{%
      \wl@warning{No Courier-like mono font found, using default}%
    }%
  }%
}

% \wl@set@font@western@auto  -- chain all three categories.
\newcommand\wl@set@font@western@{%
  \wl@set@font@serif@
  \wl@set@font@sans@
  \wl@set@font@mono@
}

%% ---- 3.3  CJK font presets ----

% \wl@set@cjk@windows
%   Windows-native Chinese fonts (YaHei for both serif and sans).
\newcommand\wl@set@cjk@windows{%
  \IfFontExistsTF{Microsoft YaHei}{%
    \setCJKmainfont{Microsoft YaHei}%
    \setCJKsansfont{Microsoft YaHei}%
    \wl@info{CJK: Microsoft YaHei (Windows)}%
  }{%
    \wl@warning{CJK font Microsoft YaHei not found on Windows}%
  }%
}

% \wl@set@cjk@mac
%   macOS Chinese fonts.
\newcommand\wl@set@cjk@mac{%
  \IfFontExistsTF{STSongti SC}{%
    \setCJKmainfont{STSongti SC}%
    \setCJKsansfont{STHeiti SC}%
    \wl@info{CJK: STSongti + STHeiti (macOS)}%
  }{%
    \IfFontExistsTF{PingFang SC}{%
      \setCJKmainfont{PingFang SC}%
      \setCJKsansfont{PingFang SC}%
      \wl@info{CJK: PingFang SC (macOS)}%
    }{%
      \wl@set@cjk@noto
    }%
  }%
}

% \wl@set@cjk@noto
%   Noto Sans CJK SC (cross-platform open-source).
\newcommand\wl@set@cjk@noto{%
  \IfFontExistsTF{Noto Sans CJK SC}{%
    \setCJKmainfont{Noto Sans CJK SC}%
    \setCJKsansfont{Noto Sans CJK SC}%
    \wl@info{CJK: Noto Sans CJK SC}%
  }{%
    \IfFontExistsTF{Source Han Sans SC}{%
      \setCJKmainfont{Source Han Sans SC}%
      \setCJKsansfont{Source Han Sans SC}%
      \wl@info{CJK: Source Han Sans SC}%
    }{%
      \wl@warning{No CJK font found, Chinese text may not render}%
    }%
  }%
}

% \wl@set@cjk@auto
%   Dispatch based on detected OS.
\newcommand\wl@set@cjk@{%
  \ifwl@os@windows
    \wl@set@cjk@windows
  \else\ifwl@os@mac
    \wl@set@cjk@mac
  \else
    \wl@set@cjk@noto
  \fi\fi
}

%% ---- 3.4  Math font presets ----
%%
%% Uses unicode-math for OpenType math fonts matching the chosen serif.
%% This is called from \AtEndPreamble so users can opt out by loading
%% unicode-math manually first, or by using legacy math font packages.
%% If unicode-math is already loaded, we try to set a matching font.
%% If it is not loaded by the user, we leave the default math setup.

\newcommand\wl@set@math@auto{%
  \@ifpackageloaded{unicode-math}{%
    \IfFontExistsTF{XITS Math}{%
      \setmathfont{XITS Math}%
      \wl@info{Math: XITS Math (unicode-math)}%
    }{%
      \IfFontExistsTF{STIX Two Math}{%
        \setmathfont{STIX Two Math}%
        \wl@info{Math: STIX Two Math (unicode-math)}%
      }{%
        \IfFontExistsTF{Libertinus Math}{%
          \setmathfont{Libertinus Math}%
          \wl@info{Math: Libertinus Math (unicode-math)}%
        }{%
          \wl@info{Math: unicode-math loaded, but no OpenType math font set}%
        }%
      }%
    }%
  }{%
    \wl@info{Math: unicode-math not loaded, using default math font}%
  }%
}

%% ---- 3.5  Master auto-detection command ----
\newcommand\wl@set@font@auto{%
  \wl@detect@os
  \wl@set@font@western@
  \wl@set@cjk@
  \wl@set@math@auto
}

%% ---- 3.6  Defer font setup to end of preamble ----
%%
%% This ensures that user packages and options (e.g., \thusetup-like
%% commands in the future) take effect before fonts are selected.
\AtEndPreamble{\wl@set@font@auto}

%% ===================================================================
%% Part 4 - Professional typography parameters
%% ===================================================================

% Slightly tighter linespacing for economical use of space
\linespread{1.05}

% Paragraph: indent-based (classical book style), no vertical gap
\setlength{\parindent}{2em}
\setlength{\parskip}{0pt}

% Prevent widows and orphans
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000

% Better ragged-bottom
\raggedbottom

%% ===================================================================
%% Part 5 - Hyperlink setup
%% ===================================================================

\hypersetup{
    colorlinks,
    citecolor=blue,
    filecolor=blue,
    linkcolor=blue,
    urlcolor=blue
}

%% ===================================================================
%% Part 6 - Utilities
%% ===================================================================

\newcommand{\HRule}[1]{\rule{\linewidth}{#1}}

%% ===================================================================
%% Part 7 - Known package conflict detection
%% ===================================================================
%%
%% These must be placed after core packages but before the preamble
%% ends — they use AtEndOfPackageFile* hooks.
%% ===================================================================

\@ifpackageloaded{unicode-math}{
  \AtEndOfPackageFile*{amsfonts}{%
    \wl@warning{Package "amsfonts" is incompatible with "unicode-math" —
      amsfonts symbols are already provided by unicode-math}%
  }
  \AtEndOfPackageFile*{amssymb}{%
    \wl@warning{Package "amssymb" is incompatible with "unicode-math" —
      amssymb symbols are already provided by unicode-math}%
  }
}{}

